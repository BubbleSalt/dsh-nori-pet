{
  "name": "@bubblesalt/dsh-nori-pet",
  "version": "0.3.0",
  "description": "Nori 桌宠：Live2D 立绘 + 唇同步 + 以 Nori 声线朗读 agent 输出",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.17.0"
  },
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "nori.config.example.json",
    "README.md"
  ],
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/BubbleSalt/dsh-nori-pet.git"
  },
  "homepage": "https://github.com/BubbleSalt/dsh-nori-pet",
  "bugs": {
    "url": "https://github.com/BubbleSalt/dsh-nori-pet/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0",
    "tsdown": "^0.22.14",
    "cordis": "npm:@deepseek-ai/cordis@^4.0.1",
    "schemastery": "npm:@deepseek-ai/schemastery@^3.18.1",
    "cosmokit": "npm:@deepseek-ai/cosmokit@^1.8.2",
    "pixi.js": "^7.4.0",
    "pixi-live2d-display": "^0.4.0",
    "url": "^0.11.3"
  },
  "scripts": {
    "typecheck": "npm run typecheck:host && npm run typecheck:client",
    "typecheck:host": "tsc -p tsconfig.json --noEmit",
    "typecheck:client": "tsc -p tsconfig.widget.json --noEmit",
    "build": "tsc -p tsconfig.json && npm run build:client",
    "build:client": "tsdown",
    "test": "npm run test:preset && npm run test:segmentation && npm run test:speakable && npm run test:speaktext && npm run test:feed-dedup && npm run test:dedup && npm run test:timers && npm run test:log-retention && npm run test:guard-fallback && npm run test:wav-ws && npm run test:tts && npm run test:util && npm run test:text && npm run test:emotion && npm run test:queue && npm run test:tts-client && npm run test:turns && npm run test:sleep && npm run test:pat && npm run test:layout && npm run test:ws && npm run test:bubble && npm run test:lip && npm run test:playback && npm run test:emodriver && npm run lint:swallow && npm run test:reframe-unit && npm run test:smoke",
    "test:preset": "node scripts/test-model-preset.mjs",
    "test:wav-ws": "node scripts/test-wav-ws.mjs",
    "test:tts": "node scripts/test-tts-handler.mjs",
    "test:util": "node scripts/test-util.mjs",
    "test:text": "node scripts/test-text-patterns.mjs",
    "test:emotion": "node scripts/test-emotion.mjs",
    "test:queue": "node scripts/test-speak-queue.mjs",
    "test:tts-client": "node scripts/test-tts-client.mjs",
    "test:turns": "node scripts/test-turns.mjs",
    "test:sleep": "node scripts/test-sleep-timer.mjs",
    "test:pat": "node scripts/test-pat-stroke.mjs",
    "test:layout": "node scripts/test-client-layout.mjs",
    "test:ws": "node scripts/test-ws-client.mjs",
    "test:bubble": "node scripts/test-bubble-queue.mjs",
    "test:lip": "node scripts/test-lip-sync.mjs",
    "test:playback": "node scripts/test-playback.mjs",
    "test:emodriver": "node scripts/test-emotion-driver.mjs",
    "lint:swallow": "node scripts/check-swallow.mjs",
    "test:reframe-unit": "node scripts/test-reframe-unit.mjs",
    "test:segmentation": "node scripts/test-segmentation.mjs",
    "test:speakable": "node scripts/test-speakable.mjs",
    "test:speaktext": "node scripts/test-speaktext.mjs",
    "test:feed-dedup": "node scripts/test-stream-feed-dedup.mjs",
    "test:dedup": "node scripts/test-stream-dedup.mjs",
    "test:timers": "node scripts/test-timer-cleanup.mjs",
    "test:log-retention": "node scripts/test-log-retention.mjs",
    "test:guard-fallback": "node scripts/test-guard-fallback.mjs",
    "test:reframe": "node scripts/test-reframe-brevity.mjs && node scripts/test-reframe-brevity.mjs --long",
    "test:guard": "node scripts/guard-release.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "guard": "node scripts/guard-release.mjs",
    "guard:staged": "node scripts/guard-release.mjs --staged"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  }
}
